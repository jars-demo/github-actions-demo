{
  "name": "pulse-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse: a tiny status API that the GitHub Actions workshop tests, releases, containerises and deploys.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/server.js",
    "status-page": "npm run build && node dist/src/status-page.js"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
